meta {
  name: Run Geodata Update
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/geodata/update
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("geodata update succeeds", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);
  });
}

docs {
  This request downloads geodata, prepares the custom proxy-domain geosite,
  restarts Xray, and finalizes consolidation. It requires
  helper [web].control_enabled = true and configured helper geodata sources.
}
