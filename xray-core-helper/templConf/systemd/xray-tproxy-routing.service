[Unit]
Description=Xray TProxy interception and policy routing
# A boot request cannot intercept before Xray reaches its post-start hook.
ConditionPathExists=/run/xray-tproxy/started

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=180

# helper:v1 bind rulemark type=uint32 source=helper.network.intercept-mark
Environment=TPROXY_MARK=${intercept_mark}
# helper:v1 bind policytable type=uint32 source=helper.network.policy-table
Environment=TPROXY_TABLE=${policy_table}

ExecStart=/usr/local/libexec/xray-tproxy/network on
ExecStopPost=/usr/local/libexec/xray-tproxy/network off

[Install]
WantedBy=multi-user.target
