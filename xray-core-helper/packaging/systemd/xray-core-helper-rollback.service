[Unit]
Description=Rollback unconfirmed Xray native configuration
Requires=xray-core-helper.service
After=xray-core-helper.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xray-core-helper -config /etc/xray-core-helper/config.toml safe-apply rollback-pending
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Only the installed native lifecycle directory, for atomic replacement.
ReadWritePaths=/usr/local/libexec/xray-tproxy /run/xray-tproxy
