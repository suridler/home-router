{
  // Root comment is retained in the content hash but never returned.
  "inbounds": [
    {
      "tag": "transparent",
      "listen": "127.0.0.1",
      "port": 52345,
      "protocol": "dokodemo-door",
      "settings": { "followRedirect": true },
      "streamSettings": { "sockopt": { "tproxy": "tproxy" } },
      "unknownInbound": { "password": "inbound-secret" }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [{ "address": "edge.example", "users": [{ "id": "11111111-1111-4111-8111-111111111111", "password": "outbound-secret" }] }]
      },
      "streamSettings": { "realitySettings": { "privateKey": "private-secret", "shortIds": ["short-secret"] } }
    },
    { "tag": "dns-out", "protocol": "dns" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        // TProxy path vless://user:secret@edge.example:443?security=reality UUID 11111111-1111-4111-8111-111111111111 UUID 77777777-7777-7777-7777-777777777777 shortId: hidden-value accessToken: bearer-secret
        "ruleTag": "gateway",
        "inboundTag": ["transparent"],
        "domain": ["domain:example.com"],
        "outboundTag": "proxy",
        "unknownRule": { "token": "rule-secret" }
      },
      { "ruleTag": "dns", "outboundTag": "dns-out", "network": "udp" }
    ],
    "balancers": [
      { "tag": "auto", "selector": ["proxy", "backup"], "strategy": { "type": "roundRobin" }, "unknown": "not returned" }
    ]
  },
  "log": { "access": "/var/log/xray/access.log", "error": "none", "loglevel": "debug", "dnsLog": true },
  "geodata": { "downloadToken": "geodata-secret", "token": "token-secret" },
  "unknownTopLevel": { "privateKey": "top-secret" },
}