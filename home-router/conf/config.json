{
  // ЛОГИРОВАНИЕ
  "log": {
    // Лог принятых/обработанных соединений.
    "access": "",
    // Лог ошибок Xray.
    "error": "",
    // На этапе настройки удобно использовать debug.
    // После завершения диагностики рекомендуется снизить до "warning"
    // или "error", чтобы не создавать большой объём логов.
    "loglevel": "warning",
    // Записывать DNS-запросы в лог.
    "dnsLog": false
  },
  // API доступен только локально для Prometheus exporter.
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:10085",
    "services": [
      "ReflectionService",
      "StatsService",
      "LoggerService",
      "HandlerService",
      "RoutingService"
    ]
  },
  // Включить внутренний сбор статистики Xray.
  "stats": {},
  // Считать трафик всех inbound и outbound.
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  // DNS
  "dns": {
    "hosts": {
      // Локальное сопоставление имени DoH-сервера с IP.
      // Это позволяет избежать зависимости от DNS при обращении к самому DNS-серверу.
      "common.dot.dns.yandex.net": "77.88.8.8",
      "cloudflare-dns.com": "1.1.1.1"
    },
    "servers": [
      {
        // Этот tag используется routing для направления
        // DNS-запросов через outbound "proxy".
        "tag": "dns-proxy",
        // DoH Cloudflare.
        "address": "https://cloudflare-dns.com/dns-query",
        // Для этих доменов используется именно этот DNS-сервер.
        "domains": [
          "geosite:ru-blocked",
          "geosite:ru-blocked-all"
        ],
        // Для совпавших доменов не переходить к fallback DNS.
        "skipFallback": true,
        // Завершить обработку DNS-запроса этим сервером.
        "finalQuery": true
      },
      {
        // DoH Яндекса через локальное разрешение имени.
        "address": "https+local://common.dot.dns.yandex.net/dns-query"
      },
      // Локальный системный DNS.
      "localhost"
    ],

    // Использовать только IPv4 при DNS-резолвинге.
    "queryStrategy": "UseIPv4",
    // Разрешить fallback на следующие DNS-серверы.
    "disableFallback": false
  },
  // INBOUNDS
  "inbounds": [
    {
      // Основной TProxy-вход.
      "tag": "tproxy-in",
      // Порт, на который nftables отправляет перехваченный трафик.
      "port": 0,
      // dokodemo-door позволяет принять соединение и сохранить
      // исходный адрес назначения при работе с TProxy.
      "protocol": "dokodemo-door",
      "settings": {
        // Перехватываем TCP и UDP.
        "network": "tcp,udp",
        // Использовать исходный адрес/порт назначения,
        // полученный от TProxy.
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          // Включить Linux TProxy.
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        // Определять протокол/домен по содержимому соединения,
        // когда это возможно.
        "enabled": true,
        // Для HTTP/TLS/QUIC использовать извлечённое имя назначения.
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        // Использовать результат sniffing для маршрутизации.
        "routeOnly": true,
        // Не ограничиваться только metadata.
        "metadataOnly": false
      }
    },
    {
      // DNS-вход для LAN-клиентов.
      "tag": "dns-in",
      // Слушаем только LAN-адрес роутера.
      "listen": "",
      // Стандартный DNS-порт.
      "port": 53,
      "protocol": "dokodemo-door",
      "settings": {
        // Принимаем DNS как TCP, так и UDP.
        "network": "tcp,udp",
        // Адрес назначения для входящего DNS.
        // Сам запрос затем передаётся внутреннему DNS-out.
        "address": "1.1.1.1",
        "port": 53
      }
    }
  ],
  // ============================================================
  // OUTBOUNDS
  // ============================================================
  "outbounds": [
    {
      // Прямое подключение без прокси.
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          // Аналогично proxy — исключаем прямой исходящий трафик Xray из повторного перехвата.
          "mark": 255
        }
      }
    },
    {
      // Прокси через VLESS.
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
          "vnext": [
            {
              "address": "",
              "port": 443,
              "users": [
                {
                  "id": "",
                  "flow": "",
                  "encryption": "none"
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "xhttp",
          "security": "reality",
          "xhttpSettings": {
            "path": "",
            "mode": "auto"
          },
          "realitySettings": {
            "publicKey": "",
            "fingerprint": "",
            "serverName": "",
            "shortId": "",
            "spiderX": ""
          },
                "sockopt": {
              // ВАЖНО:
              // nftables использует этот mark для исключения исходящего трафика Xray из повторного TProxy.
              // В nftables meta mark 0x000000ff accept
              // Поэтому исходящий трафик Xray не зацикливается обратно в TProxy.
              "mark": 255
            }
        }
    },
    {
      // Блокировка соединения.
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      // Внутренний DNS outbound Xray.
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "hijack"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          // Аналогично proxy — исключаем прямой исходящий трафик Xray из повторного перехвата.
          "mark": 255
        }
      }
    }
  ],
  // ROUTING
  "routing": {
    // Если доменное правило не совпало, Xray при необходимости пытается получить IP домена и продолжить маршрутизацию по IP-правилам.
    "domainStrategy": "AsIs",
    "rules": [
      {
        // DNS от LAN-клиентов отправляем во внутренний DNS-out.
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        // DNS-сервер с tag "dns-proxy" работает через outbound "proxy".
        "type": "field",
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        // Постоянный пользовательский список доменов.
        "type": "field",
        "domain": [
          "ext:geosite_IR.dat:PROXY"
        ],
        "outboundTag": "proxy",
        "ruleTag": "proxy-domains-permanent"
      },
      {
        // Локальные/private IP отправляем напрямую.
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct",
        "ruleTag": "hook-local",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }
      },
      {
        // Реклама — блокировка.
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block",
        "ruleTag": "hook-block",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }
      },
      {
        // Ресурсы, которые должны открываться непосредственно из российской сети.
        "type": "field",
        "domain": [
          "geosite:ru-available-only-inside",
          "geosite:category-gov-ru"
        ],
        "outboundTag": "direct",
        "ruleTag": "hook-direct-ru-only",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }
      },
      {
        // Домены, которые должны идти через прокси.
        "type": "field",
        "domain": [
          "geosite:ru-blocked",
          "geosite:ru-blocked-all",
          "geosite:google"
        ],
        "outboundTag": "proxy",
        "ruleTag": "hook-proxy-blocked",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }
      },
      {
        // IP-диапазоны, которые должны идти через прокси.
        "type": "field",
        "ip": [
          "geoip:ru-blocked",
          "geoip:telegram",
          "geoip:google"
        ],
        "outboundTag": "proxy",
        "ruleTag": "hook-proxy-blocked",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }

      },
      {
        // Российские IP — напрямую.
        "type": "field",
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct",
        "ruleTag": "hook-direct-ru",
        "webhook": {
          "url": "/run/xray-routing-exporter/routing-webhook.sock:/webhook",
          "deduplication": 0
        }
      }
      // Всё что не попало в правила пойдет через 1 desination
      // сейчас это "direct"
    ]
  }
}
